# ---------------------------------------------------------------------------
# Line endings
# ---------------------------------------------------------------------------
# This repository is normalised to LF and was verified byte-level at LF before
# its first commit. Without this file the result depends on each contributor's
# `core.autocrlf`, which on Windows defaults to `true` and rewrites the working
# copy to CRLF.
#
# That matters here for a concrete reason: this repository ships ~90 shell
# scripts and a CRLF shebang line does not execute on Linux or macOS. The
# failure is `bad interpreter: /usr/bin/env^M: no such file or directory`,
# which names the interpreter rather than the line ending and so reads as a
# missing tool rather than a corrupted file.
#
# `* text=auto` lets git normalise to LF in the repository. The explicit `eol=lf`
# entries below force LF in the WORKING COPY too, for the file types where a CRLF
# is a functional defect rather than a cosmetic one.

* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.java  text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.smali text eol=lf
*.pro   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.gradle text eol=lf
Makefile text eol=lf

# Binary-ish assets: never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.apk   binary
*.dex   binary
*.so    binary
*.jar   binary

# ---------------------------------------------------------------------------
# Files that are CONSUMED ON AN ANDROID DEVICE, where CRLF is a functional bug
# ---------------------------------------------------------------------------
# These are not source in the usual sense -- they are parsed by Magisk, by the
# Xposed/LSPosed loader, by init, or by the SELinux policy compiler, all of
# which are line-oriented and none of which tolerate a trailing CR. A CRLF here
# produces a module that silently does not load, which is far harder to debug
# than a syntax error.

*.aidl      text eol=lf
*.cil       text eol=lf
*.rule      text eol=lf
*.prop      text eol=lf
*.rc        text eol=lf
*.s         text eol=lf
*.patch     text eol=lf
*.csv       text eol=lf
*.b64       text eol=lf
*.html      text eol=lf
*.log       text eol=lf
*.txt       text eol=lf

# Extensionless files read as config or scripts on-device or by tooling.
xposed_init         text eol=lf
skip_mount          text eol=lf
hosts               text eol=lf
vendor_seapp_contexts text eol=lf
seapp_contexts      text eol=lf
LICENSE             text eol=lf
.gitignore          text eol=lf
.gitattributes      text eol=lf
.gitkeep            text eol=lf
